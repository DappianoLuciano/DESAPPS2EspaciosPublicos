VITE_API_URL="http://localhost:3000"

# OAuth Client ID (Web) de Google Cloud Console, el mismo valor que GOOGLE_CLIENT_ID en el backend.
VITE_GOOGLE_CLIENT_ID="REPLACE_ME.apps.googleusercontent.com"

# Opcional. En "true" muestra el login mockeado (ciudadano/admin de prueba) aunque el build sea de produccion.
# Tiene que coincidir con ALLOW_MOCK_AUTH del backend para que las llamadas a la API funcionen.
VITE_ENABLE_MOCK_LOGIN="false"
