VITE_API_URL="http://localhost:3000"

# OAuth Client ID (Web) de Google Cloud Console, el mismo valor que GOOGLE_CLIENT_ID en el backend.
VITE_GOOGLE_CLIENT_ID="REPLACE_ME.apps.googleusercontent.com"

# Opcional. En "true" muestra el login mockeado (ciudadano/admin de prueba) aunque el build sea de produccion.
# Tiene que coincidir con ALLOW_MOCK_AUTH del backend para que las llamadas a la API funcionen.
VITE_ENABLE_MOCK_LOGIN="false"

# Proveedor de Identidad CityPass+ (Grupo 2 - Login federado para administradores)
VITE_CITYPASS_IDP_URL="https://api.citypass-login.pp.ua"
VITE_CITYPASS_CLIENT_ID="citypass-espacios-web"

# Opcional: endpoint de geocodificacion compatible con la respuesta search de Nominatim.
# La busqueda es explicita (no autocomplete), con cache y limite local de 1 consulta/segundo.
# API publica: uso moderado; el limite es global por aplicacion, no por usuario.
# Para varios usuarios concurrentes usar un proveedor/proxy con cache y limite compartidos.
# Politica: https://operations.osmfoundation.org/policies/nominatim/
# VITE_GEOCODING_URL="https://nominatim.openstreetmap.org/search"
