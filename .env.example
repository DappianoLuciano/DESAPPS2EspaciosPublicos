# Variables para "docker compose up" (stack 100% local: Postgres + backend +
# frontend + proxy TLS), definido en docker-compose.yml.
#
# Este flujo es independiente del modo "dos terminales" documentado en el
# README (que usa la instancia de Supabase compartida por el equipo): aca la
# base de datos es un Postgres local descartable, para no arriesgar tocar
# datos compartidos solo por levantar el stack en Docker.
#
# Copiar a ".env" en la raiz del repo y ajustar si hace falta:
#   cp .env.example .env
# ".env" esta en .gitignore, no commitear credenciales reales aca.

# --- Postgres local ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=citypass_espacios_cultura

# --- Backend (espacios-publicos-backend) ---
PORT=3000

# Apunta al servicio "postgres" de este mismo docker-compose (no a Supabase).
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/citypass_espacios_cultura
DIRECT_URL=postgresql://postgres:postgres@postgres:5432/citypass_espacios_cultura

# Generar un valor propio, largo y aleatorio. No reusar el de otros entornos.
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_LARGO_Y_ALEATORIO

# Login con Google real (opcional). Sin este valor, usar el login mockeado.
GOOGLE_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com

# Habilitado por defecto para que el stack funcione sin credenciales de Google:
# permite el login mockeado (ciudadano/admin de prueba) aunque el backend corra
# en modo production dentro del contenedor.
ALLOW_MOCK_AUTH=true

# Clima y bus de eventos. Por defecto se usa ConsoleEventBus, sin depender de LDAP/EDA.
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
WEATHER_ZONE=CABA
WEATHER_LATITUDE=-34.6037
WEATHER_LONGITUDE=-58.3816
WEATHER_FORECAST_HOURS=24
WEATHER_HEAT_DAILY_MIN_C=22
WEATHER_HEAT_DAILY_MAX_C=32
CRON_SECRET=CAMBIAR_POR_UN_SECRETO_DE_CRON
EVENT_BUS_DRIVER=console
EVENT_GATEWAY_API_URL=http://host.docker.internal:8080/api/v1
EVENT_AUTH_TOKEN_URL=http://host.docker.internal:8083/oauth/token
EVENT_CLIENT_ID=
EVENT_CLIENT_SECRET=
WEATHER_CONFIRMED_EVENT_FQN=com.citypass.espacios.CriticidadClimaticaConfirmada
WEATHER_FINALIZED_EVENT_FQN=com.citypass.espacios.CriticidadClimaticaFinalizada

# Origen desde el que el navegador sirve el frontend dockerizado (ver
# FRONTEND_PORT mas abajo). El backend en modo production solo acepta CORS de
# los origenes listados aca.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# CityPass+ IdP (Autenticacion e identidad para Administradores)
CITYPASS_IDP_ISSUER=https://idp.citypass.local
CITYPASS_IDP_JWKS_URL=https://api.citypass-login.pp.ua/.well-known/jwks.json
CITYPASS_IDP_AUDIENCE=citypass-espacios-api
CITYPASS_ADMIN_GROUPS=admin,espacios-admin,administrador,municipal_admin,delegados,soporte-n2

# Opcionales: sin estos, todo el stack funciona salvo /api/uploads (Supabase
# Storage) y /api/chat (chatbot con Gemini).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_EVENT_IMAGES_BUCKET=event-images
GEMINI_API_KEY=

# --- Proxy TLS local (Caddy) ---
# Termina HTTPS con un certificado autofirmado porque el backend exige HTTPS
# en modo production (ver docker/tls-proxy/Caddyfile).
TLS_PROXY_PORT=8443

# --- Frontend (espacios-publicos-frontend) ---
# Puerto publicado en el host para acceder a la aplicacion.
FRONTEND_PORT=5173

# Se usan como build args de la imagen (Vite los hornea en el bundle en build
# time, ver espacios-publicos-frontend/Dockerfile). VITE_API_URL debe apuntar
# al proxy TLS de arriba, no al backend directo.
VITE_API_URL=https://127.0.0.1:8443
VITE_GOOGLE_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
VITE_ENABLE_MOCK_LOGIN=true
VITE_CITYPASS_IDP_URL=https://api.citypass-login.pp.ua
VITE_CITYPASS_CLIENT_ID=citypass-espacios-web
