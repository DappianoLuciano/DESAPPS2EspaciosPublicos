PORT=3000

# Nivel minimo de log emitido por el backend (pino): trace, debug, info, warn, error, fatal o silent.
LOG_LEVEL=info

# Supabase transaction pooler, used by the running API.
# Copy the exact host and username from Supabase > Connect > ORMs > Prisma.
# URL-encode DB_PASSWORD when it contains reserved URL characters.
DATABASE_URL="postgresql://postgres.PROJECT_REF:DB_PASSWORD_URL_ENCODED@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

# Supabase session pooler, used by Prisma migrations and seeds.
DIRECT_URL="postgresql://postgres.PROJECT_REF:DB_PASSWORD_URL_ENCODED@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_REPLACE_ME"
SUPABASE_EVENT_IMAGES_BUCKET="event-images"

# Google Gemini API key para el chatbot cultural
GEMINI_API_KEY="AIzaSy_REPLACE_ME"

# OAuth Client ID (Web) de Google Cloud Console, usado para verificar el boton "Iniciar sesion con Google".
GOOGLE_CLIENT_ID="REPLACE_ME.apps.googleusercontent.com"

# Secreto propio para firmar los JWT de sesion. Generar un valor random largo, no reusar entre entornos.
JWT_SECRET="REPLACE_ME_RANDOM_SECRET"

# Opcional. En "true" habilita el login mockeado (ciudadano/admin de prueba) aunque el entorno sea de produccion.
# Pensado para demos publicas; en un despliegue real conviene dejarlo sin definir.
ALLOW_MOCK_AUTH="false"

# SMTP usado para notificar por mail al ciudadano cuando se confirma una reserva
# (ver NodemailerEmailSender). Sin estos valores el envio falla silenciosamente
# (se loguea el error, pero la reserva se confirma igual).
SMTP_HOST="smtp.REPLACE_ME.com"
SMTP_PORT=587
SMTP_USER="REPLACE_ME"
SMTP_PASS="REPLACE_ME"

# URL publica del frontend, usada para armar el link de verificacion que va en
# el mail de confirmacion de reserva. Sin este valor se usa localhost:5173.
FRONTEND_URL="http://localhost:5173"
