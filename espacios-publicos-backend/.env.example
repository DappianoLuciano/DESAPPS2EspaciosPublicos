PORT=3000

# Nivel minimo de log emitido por el backend (pino): trace, debug, info, warn, error, fatal o silent.
LOG_LEVEL=info

# Supabase transaction pooler, used by the running API.
# Copy the exact host and username from Supabase > Connect > ORMs > Prisma.
# URL-encode DB_PASSWORD when it contains reserved URL characters.
DATABASE_URL="postgresql://postgres.PROJECT_REF:DB_PASSWORD_URL_ENCODED@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

# Supabase session pooler, used by Prisma migrations and seeds.
DIRECT_URL="postgresql://postgres.PROJECT_REF:DB_PASSWORD_URL_ENCODED@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_REPLACE_ME"
SUPABASE_EVENT_IMAGES_BUCKET="event-images"

# Google Gemini API key para el chatbot cultural
GEMINI_API_KEY="AIzaSy_REPLACE_ME"

# OAuth Client ID (Web) de Google Cloud Console, usado para verificar el boton "Iniciar sesion con Google".
GOOGLE_CLIENT_ID="REPLACE_ME.apps.googleusercontent.com"

# Secreto propio para firmar los JWT de sesion. Generar un valor random largo, no reusar entre entornos.
JWT_SECRET="REPLACE_ME_RANDOM_SECRET"

# Opcional. En "true" habilita el login mockeado (ciudadano/admin de prueba) aunque el entorno sea de produccion.
# Pensado para demos publicas; en un despliegue real conviene dejarlo sin definir.
ALLOW_MOCK_AUTH="false"

# SMTP usado para notificar por mail al ciudadano cuando se confirma una reserva
# (ver NodemailerEmailSender). Sin estos valores el envio falla silenciosamente
# (se loguea el error, pero la reserva se confirma igual).
SMTP_HOST="smtp.REPLACE_ME.com"
SMTP_PORT=587
SMTP_USER="REPLACE_ME"
SMTP_PASS="REPLACE_ME"
# Opcional. Remitente del mail; por defecto se usa SMTP_USER (Gmail rechaza/reescribe otro remitente).
SMTP_FROM='"Espacios Publicos" <REPLACE_ME@gmail.com>'

# URL publica del frontend, usada para armar el link de verificacion que va en
# el mail de confirmacion de reserva. Sin este valor se usa localhost:5173.
FRONTEND_URL="http://localhost:5173"

# Proveedor de Identidad CityPass+ (Grupo 2 - Login federado para administradores)
CITYPASS_IDP_ISSUER="https://idp.citypass.local"
CITYPASS_IDP_JWKS_URL="https://api.citypass-login.pp.ua/.well-known/jwks.json"
CITYPASS_IDP_AUDIENCE="citypass-espacios-api"
CITYPASS_ADMIN_GROUPS="admin,espacios-admin,administrador,municipal_admin,delegados,soporte-n2"
CITYPASS_STRICT_AUDIENCE="false"
CITYPASS_JWKS_TIMEOUT_MS=2000

# Consulta meteorologica. Los umbrales son tecnicos para la demo y deben acordarse
# con el negocio antes de usarse como criterio oficial de seguridad.
OPEN_METEO_URL="https://api.open-meteo.com/v1/forecast"
WEATHER_ZONE="CABA"
WEATHER_LATITUDE=-34.6037
WEATHER_LONGITUDE=-58.3816
# Opcional: varios puntos de pronóstico. Si no se define, se consulta el punto anterior.
# WEATHER_LOCATIONS='[{"latitude":-34.6037,"longitude":-58.3816},{"latitude":-34.5631,"longitude":-58.4584}]'
WEATHER_FORECAST_HOURS=24
WEATHER_LOW_WIND_GUST_KMH=35
WEATHER_MEDIUM_WIND_GUST_KMH=50
WEATHER_HIGH_WIND_GUST_KMH=70
WEATHER_CRITICAL_WIND_GUST_KMH=100
WEATHER_LOW_PRECIPITATION_MM=5
WEATHER_MEDIUM_PRECIPITATION_MM=20
WEATHER_HIGH_PRECIPITATION_MM=40
WEATHER_CRITICAL_PRECIPITATION_MM=80

# Protege POST /api/internal/weather-cycle. Debe coincidir con el secreto del scheduler.
CRON_SECRET="REPLACE_ME_RANDOM_CRON_SECRET"

# EventBus: console deja trazabilidad local; citypass publica por HTTP al gateway EDA.
EVENT_BUS_DRIVER="console"
EVENT_GATEWAY_API_URL="http://localhost:8080/api/v1"
EVENT_AUTH_TOKEN_URL="http://localhost:8083/oauth/token"
EVENT_CLIENT_ID="REPLACE_ME"
EVENT_CLIENT_SECRET="REPLACE_ME"
WEATHER_CONFIRMED_EVENT_FQN="com.citypass.espacios.CriticidadClimaticaConfirmada"
WEATHER_FINALIZED_EVENT_FQN="com.citypass.espacios.CriticidadClimaticaFinalizada"
