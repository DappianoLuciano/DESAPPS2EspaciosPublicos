generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ReservationStatus {
  CONFIRMED
  CANCELLED
}

enum CommunityEventStatus {
  ACTIVE
  ACTIVE_FULL
  CANCELLED
}

enum PublicSpaceStatus {
  ENABLED
  DISABLED
}

enum UserRole {
  CITIZEN
  MUNICIPAL_ADMIN
}

model User {
  id        String   @id @default(uuid())
  googleId  String   @unique
  email     String   @unique
  name      String
  avatarUrl String?
  role      UserRole @default(CITIZEN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Admin {
  id         String   @id @default(uuid())
  username   String   @unique
  name       String
  email      String   @unique
  phone      String?
  department String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("admins")
}

model PublicSpace {
  id          String           @id @default(uuid())
  name        String
  description String
  address     String
  zone        String           @default("Sin definir")
  capacity    Int
  // Coordenadas WGS84. Opcionales para no romper los espacios ya cargados, pero
  // sin ellas el espacio no participa de la ruta urbana (CU-INT-01): Movilidad
  // las necesita para buscar estaciones y nosotros para detectar incidentes cerca.
  latitude    Float?
  longitude   Float?
  status      PublicSpaceStatus @default(ENABLED)
  imageUrl    String?
  createdAt   DateTime         @default(now())
  reservations Reservation[]
  events      CommunityEvent[]

  @@map("public_spaces")
}

model Reservation {
  id            String            @id @default(uuid())
  publicSpaceId String
  requesterName String
  requesterEmail String
  estimatedAttendees Int
  startDate     DateTime
  endDate       DateTime
  status        ReservationStatus @default(CONFIRMED)
  createdAt     DateTime          @default(now())
  publicSpace   PublicSpace       @relation(fields: [publicSpaceId], references: [id])

  @@index([publicSpaceId, startDate, endDate])
  @@map("reservations")
}

model CommunityEvent {
  id            String      @id @default(uuid())
  title         String
  category      String
  tags          String[]    @default([])
  description   String
  requirements  String[]    @default([])
  publicSpaceId String
  organizerName String
  capacity      Int
  requiresRegistration Boolean @default(true)
  startDate     DateTime
  endDate       DateTime
  status        CommunityEventStatus @default(ACTIVE)
  imageUrl      String?
  createdAt     DateTime    @default(now())
  publicSpace   PublicSpace @relation(fields: [publicSpaceId], references: [id])
  registrations CommunityEventRegistration[]

  @@index([publicSpaceId, startDate, endDate])
  @@map("community_events")
}

model CommunityEventRegistration {
  id               String         @id @default(uuid())
  communityEventId String
  citizenName      String
  citizenEmail     String
  createdAt        DateTime       @default(now())
  communityEvent   CommunityEvent @relation(fields: [communityEventId], references: [id])

  @@unique([communityEventId, citizenEmail])
  @@index([communityEventId])
  @@map("community_event_registrations")
}

model EventOutbox {
  id          String    @id
  name        String
  payload     Json
  occurredAt  DateTime
  publishedAt DateTime?
  attempts    Int       @default(0)
  lastError   String?
  createdAt   DateTime  @default(now())

  @@index([name])
  @@index([publishedAt, createdAt])
  @@map("event_outbox")
}

// Eventos recibidos por webhook desde el gateway (CU-INT-01). La entrega es
// at-least-once: el eventId de la metadata del gateway es estable entre
// reintentos, asi que con guardarlo alcanza para no procesar dos veces.
model InboundEvent {
  eventId    String   @id
  eventType  String
  receivedAt DateTime @default(now())

  @@map("inbound_events")
}

// Un incidente ya avisado para un evento no se vuelve a avisar, aunque llegue
// por otro tipo de evento (por ejemplo, el mismo reclamo reclasificado).
model EventIncidentImpact {
  id               String   @id @default(uuid())
  communityEventId String
  source           String
  incidentId       String
  distanceMeters   Int
  createdAt        DateTime @default(now())

  @@unique([communityEventId, source, incidentId])
  @@map("event_incident_impacts")
}
